-- Fraud Detection Query 1
-- Rapid transactions within 1 minute

SELECT sender_account_id,
DATE_FORMAT(txn_time,'%Y-%m-%d %H:%i') AS minute_slot,
COUNT(*) AS txn_count
FROM Transactions
GROUP BY sender_account_id, minute_slot
HAVING COUNT(*) >= 3;


-- Fraud Detection Query 2
-- High value midnight transactions

SELECT txn_id, sender_account_id, amount, txn_time
FROM Transactions
WHERE HOUR(txn_time) BETWEEN 0 AND 4
AND amount > 50000;


-- Fraud Detection Query 3
-- Suspicious login locations

SELECT user_id, COUNT(DISTINCT city) AS city_count
FROM Login_Logs
GROUP BY user_id
HAVING COUNT(DISTINCT city) > 2;


-- Create Fraud Report View

CREATE VIEW Fraud_Report AS
SELECT txn_id,
sender_account_id,
receiver_account_id,
amount,
txn_time,
CASE
WHEN amount > 50000 AND HOUR(txn_time) BETWEEN 0 AND 4
THEN 'High Value Night Transfer'
WHEN amount > 50000
THEN 'High Value Transfer'
WHEN HOUR(txn_time) BETWEEN 0 AND 4
THEN 'Odd Hour Transaction'
ELSE 'Normal'
END AS fraud_reason
FROM Transactions
WHERE amount > 50000
OR HOUR(txn_time) BETWEEN 0 AND 4;


-- Indexes for Performance

CREATE INDEX idx_sender ON Transactions(sender_account_id);
CREATE INDEX idx_time ON Transactions(txn_time);
CREATE INDEX idx_amount ON Transactions(amount);


-- View Fraud Report

SELECT * FROM Fraud_Report;
