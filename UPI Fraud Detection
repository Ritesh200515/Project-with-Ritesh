-- Create Database
CREATE DATABASE upi_fraud_detection;
USE upi_fraud_detection;


-- Users Table

CREATE TABLE Users(
user_id INT PRIMARY KEY AUTO_INCREMENT,
full_name VARCHAR(100),
phone VARCHAR(15),
email VARCHAR(100),
city VARCHAR(50),
created_at DATE
);


-- Merchants Table

CREATE TABLE Merchants (
merchant_id INT PRIMARY KEY AUTO_INCREMENT,
merchant_name VARCHAR(100),
category VARCHAR(50),
city VARCHAR(50)
);


-- Devices Table

CREATE TABLE Devices (
device_id INT PRIMARY KEY AUTO_INCREMENT,
user_id INT,
device_type VARCHAR(50),
device_os VARCHAR(50),
last_login_city VARCHAR(50),
FOREIGN KEY (user_id) REFERENCES Users(user_id)
);


-- Bank Accounts Table

CREATE TABLE Bank_Accounts (
account_id INT PRIMARY KEY AUTO_INCREMENT,
user_id INT,
bank_name VARCHAR(100),
account_type VARCHAR(50),
balance DECIMAL(12,2),
created_at DATE,
FOREIGN KEY (user_id) REFERENCES Users(user_id)
);


-- Transactions Table

CREATE TABLE Transactions (
txn_id INT PRIMARY KEY AUTO_INCREMENT,
sender_account_id INT,
receiver_account_id INT,
merchant_id INT NULL,
amount DECIMAL(12,2),
txn_time DATETIME,
txn_type VARCHAR(10),
status VARCHAR(20),
device_id INT,
FOREIGN KEY (sender_account_id) REFERENCES Bank_Accounts(account_id),
FOREIGN KEY (receiver_account_id) REFERENCES Bank_Accounts(account_id),
FOREIGN KEY (merchant_id) REFERENCES Merchants(merchant_id),
FOREIGN KEY (device_id) REFERENCES Devices(device_id)
);
-- Login Logs Table

CREATE TABLE Login_Logs (
log_id INT PRIMARY KEY AUTO_INCREMENT,
user_id INT,
login_time DATETIME,
city VARCHAR(50),
device_id INT,
FOREIGN KEY (user_id) REFERENCES Users(user_id),
FOREIGN KEY (device_id) REFERENCES Devices(device_id)
);


